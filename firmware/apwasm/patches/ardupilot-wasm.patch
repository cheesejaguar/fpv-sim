--- a/libraries/SITL/SIM_JSON.cpp
+++ b/libraries/SITL/SIM_JSON.cpp
@@ -83,6 +83,45 @@ JSON::JSON(const char *frame_str) :
     }
 }
 
+#if defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+#include <emscripten/proxying.h>
+// fpv-sim: the physics runs in JavaScript (a Web Worker or a Node worker thread). Module.fpvsim
+// copies the servo packet out and blocks on shared memory until the next state line comes back.
+EM_JS(int, fpvsim_servo_out, (const void *pkt, int len), {
+    return Module['fpvsim'].servoOut(HEAPU8, pkt, len);
+});
+EM_JS(int, fpvsim_state_in, (void *buf, int max, int timeout_ms), {
+    return Module['fpvsim'].stateIn(HEAPU8, buf, max, timeout_ms);
+});
+#endif
+
+ssize_t JSON::send_packet(const void *pkt, size_t len)
+{
+#if defined(__EMSCRIPTEN__)
+    return fpvsim_servo_out(pkt, int(len));
+#else
+    return sock.sendto(pkt, len, target_ip, control_port);
+#endif
+}
+
+ssize_t JSON::recv_packet(void *buf, size_t len, uint32_t timeout_ms)
+{
+#if defined(__EMSCRIPTEN__)
+    // the other threads' file-system calls run on this thread (Emscripten proxies them here):
+    // serve them while waiting for the physics, a millisecond at a time
+    for (uint32_t waited = 0; ; waited++) {
+        emscripten_proxy_execute_queue(emscripten_proxy_get_system_queue());
+        const int n = fpvsim_state_in(buf, int(len), 1);
+        if (n > 0 || waited >= timeout_ms) {
+            return n;
+        }
+    }
+#else
+    return sock.recv(buf, len, timeout_ms);
+#endif
+}
