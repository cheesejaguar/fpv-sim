{
  "name": "fpv-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "predev": "node scripts/build-map-index.mjs && node scripts/build-bemt-tables.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-map-index.mjs && node scripts/build-licenses.mjs && node scripts/build-bemt-tables.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/fetch-fonts.mjs",
    "firmware": "bash scripts/build-firmware.sh",
    "map:index": "node scripts/build-map-index.mjs",
    "bemt": "node scripts/build-bemt-tables.mjs",
    "map:validate": "node scripts/validate-map.mjs",
    "licenses": "node scripts/build-licenses.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "bench:sim": "node scripts/bench-sim.mjs",
    "api": "node scripts/fpv-api.mjs",
    "resim": "node scripts/resim.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
